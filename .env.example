POSTGRES_PORT=15432
POSTGRES_DB=pics2text
POSTGRES_USER=pics2text
POSTGRES_PASSWORD=pics2text_dev

REDIS_PORT=16379

RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=pics2text
RABBITMQ_PASSWORD=pics2text_dev

S3_PORT=19000
S3_ACCESS_KEY=pics2text
S3_SECRET_KEY=pics2text_dev_secret
S3_BUCKET=pics2text
S3_ENDPOINT=http://localhost:19000
S3_PUBLIC_ENDPOINT=http://localhost:19000
S3_REGION=us-east-1
S3_PRESIGN_DURATION=15m
S3_UPLOAD_TTL=24h
PHOTO_VERIFICATION_LEASE=30m
PHOTO_COMPLETION_GLOBAL_LIMIT=4
PHOTO_COMPLETION_PER_USER_LIMIT=3
PHOTO_COMPLETION_RETRY_AFTER=1s
S3_MULTIPART_THRESHOLD=10485760
S3_MULTIPART_PART_SIZE=8388608

# 高清印刷渲染 Worker；Docker profile 会提供 libvips、pyvips 和 sRGB ICC。
RENDER_WORKER_PORT=18082
RENDER_WORKER_MEMORY_LIMIT=2g
PRINT_RENDER_MAX_SOURCE_BYTES=1073741824
PRINT_RENDER_MAX_OUTPUT_BYTES=1099511627776
PRINT_RENDER_NATIVE_MEMORY_BYTES=536870912
PRINT_RENDER_MAX_OPEN_FILES=256
PRINT_RENDER_TIMEOUT=6h
PRINT_RENDER_STALE_TEMP_AGE=24h
PRINT_RENDER_CLEANUP_INTERVAL=1h

# 仅限首次创建系统管理员；部署环境必须替换为随机高强度值。
IDENTITY_BOOTSTRAP_TOKEN=pics2text-bootstrap-dev
IDENTITY_REGISTRATION_ENABLED=true
LOGIN_MAXIMUM_ATTEMPTS=5
LOGIN_LOCK_DURATION=15m
